# outpost — single-node k3s VM.
#
# GENERATED by `fort scaffold outpost` from its manifest,
# forts/outpost.toml. Scaffolding never overwrites this
# file — the manifest seeds the host, you refine it here.
#
# Built as a qcow2 via the upstream image framework (#95) — the flake auto-
# discovers this dir and exposes it as `outpost-qcow` (the
# runtime-qemu import below says which variant). The root filesystem and
# bootloader come from runtime/qemu.nix + the qemu image variant, so there
# is no hand-written hardware.nix.
# HARDENED (every fort, modules/hardened.nix): SSH answers on the
# wireguard mesh address ONLY — reach it as `ops@10.10.0.10`,
# not the LAN/public IP. No personal account, no home stack, no wheel: the
# one login is `ops` (modules/ops/account.nix). Break-glass is the console password
# (ops/console.nix) at the machine's own console — `virsh console
# outpost` on the hypervisor.
{ inputs, ... }:

{
  imports = [
    # qcow VM runtime contract (virtio guest profile, root-by-label, grub on
    # /dev/vda, serial console) — declares sfi.platform = "qemu", which is
    # how the flake knows to build `outpost-qcow`.
    inputs.forts.nixosModules.runtime-qemu
    # Role modules — the host dir is self-describing so the flake stays uniform
    # and needs no per-host edit when a new host gets a manifest.
    ./secrets.nix
    inputs.forts.nixosModules.k3s-server
    inputs.forts.nixosModules.wireguard    # mesh member (mesh_ip in the manifest)
    # The baseline every fort imports, which k3s-server names too: the
    # hardening (mesh-only SSH, no home stack, #86/#417) and the operator
    # account `ops` with the ops verbs (#647). k3s-server adds the
    # cluster grant and the ports. The keys of `ops` are the estate's,
    # not the framework's: estate.toml's operator_keys (sfi/forts#81).
    inputs.forts.nixosModules.hardened
    inputs.forts.nixosModules.ops-account
    # Day-0 flux: fort scaffold laid down
    # flux/clusters/outpost/ and fort mint seeded flux-sops-age-key
    # into this host's sops file. No deploy key: the estate's repo is
    # public, cloned anonymously over https (estate.toml [source], forts#167).
    inputs.forts.nixosModules.flux-bootstrap
    inputs.forts.nixosModules.auto-rebuild # pull-based OS updates (#93)
    # The operator defaults every fort carries (sfi/forts#24): the shell at
    # a pane, and the console door — a password for `ops` that only a
    # getty accepts, so an operator reaches `sudo nixos-rollback` after
    # the mesh breaks (#524). fort mint minted the hash into this host's
    # sops file and the passphrase into provisioning/console-passwords.yaml.
    inputs.forts.nixosModules.shell
    inputs.forts.nixosModules.ops-console
  ];

  networking.hostName = "outpost";

  # The estate this host is declared in: three levels up from this file.
  # The framework's modules (inputs.forts.nixosModules.*, above) read the
  # estate's files — mesh/peers.json, the flux tree, nixos/.sops.yaml, the
  # lab CA — under this root (modules/estate.nix in sfi/forts).
  sfi.estate.root = ../../..;

  # zsh and the shared prompt for whoever reads a pane here (#576). The
  # prompt's host label is the module's bright-black; a fort that wants
  # another sets sfi.shell.starshipSettings.hostname.style here (#582).
  sfi.shell.enable = true;

  # The console door (#524): the getty reads ops-password-hash from
  # this host's sops file, and sshd still refuses the password. Read the
  # passphrase with `fort console-password outpost --show`; replace
  # it with `--rotate`.
  sfi.ops.console.enable = true;

  # BREAK-GLASS, off (sfi/forts#195): flip to true to give ops
  # `sudo -i` — and cluster-admin kubectl on a cluster fort — behind the
  # admin-key challenge (modules/ops/admin.nix; docs/ops.md "Escalating
  # to Admin"). The challenge options live at sfi.ops.admin.challenge.*;
  # its enable defaults to true, and false is passwordless sudo.
  sfi.ops.admin.enable = false;

  sfi.flux-bootstrap = {
    enable = true;
    cluster = "outpost";
  };

  # Watch main (minutely gate, rebuild only when the closure inputs
  # changed); a changed host config lands within minutes — or now, via
  # `sudo nixos-pull` (#93).
  sfi.auto-rebuild.enable = true;
  sfi.auto-rebuild.repoUrl = "https://github.com/streetfortress/estate-examples.git"; # the estate (estate.toml): what the gate watches and the rebuild clones

  # Static address on the hypervisor's LAN bridge — matches [libvirt] ip in
  # forts/outpost.toml.
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-lan" = {
    matchConfig.Name = "en*";
    address = [ "192.168.1.10/24" ];
    gateway = [ "10.0.0.1" ];
    dns = [ "10.0.0.2" "8.8.8.8" ];
  };
  # Single-node server on the sqlite datastore ([cluster] datastore in
  # the manifest): a single node buys nothing from etcd, and k3s-server
  # with etcd was a third of a 4 GB node (#163/#164). Server config and
  # the k3s-token requirement come from modules/k3s-server.nix, which
  # maps the datastore to services.k3s.clusterInit.
  sfi.k3s.datastore = "sqlite";

  # zram swap (#163): swapless 4 GB nodes hit page-cache thrash as a
  # cliff (memory PSI full-stalls while the kernel re-reads evicted
  # program text; kubelet never sees MemoryPressure). Compressed swap in
  # RAM makes it gradual and observable. The lab shape has no disk swap
  # tier: zram is all there is.
  zramSwap = {
    enable = true;
    memoryPercent = 50;
  };
  boot.kernel.sysctl = {
    # swap is now cheaper than a disk round-trip, so swap aggressively
    # instead of shredding page cache…
    "vm.swappiness" = 180;
    # …and don't readahead swap pages (no seek penalty on zram).
    "vm.page-cluster" = 0;
  };

  # sops wiring is in ./secrets.nix: it points defaultSopsFile at
  # secrets/outpost.yaml and decrypts via the pre-seeded SSH host key
  # (age.sshKeyPaths), which the initrd places from the NoCloud cidata
  # volume before activation (modules/runtime/seed.nix, #657). Secrets are
  # split per-host, so this host only declares the keys it actually carries —
  # no declared-but-absent secrets to fail activation.

  system.stateVersion = "25.11";
}
