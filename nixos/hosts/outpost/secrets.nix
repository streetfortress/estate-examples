# sops-nix wiring for outpost: decrypts secrets/outpost.yaml
# with the age key derived from this host's SSH ed25519 host key
# (minted by fort mint and placed by the initrd from the NoCloud
# cidata volume before activation (modules/runtime/seed.nix, #657) — the host never
# generates its own). k3s-token is
# declared by modules/k3s-server.nix; wireguard-private-key (declared
# below) is consumed by modules/wireguard.nix. ops-password-hash is
# declared by modules/ops/console.nix, which the host file enables.
#
# GENERATED by `fort scaffold outpost` (only when absent).
{ ... }:

{
  sops = {
    defaultSopsFile = ../../secrets/outpost.yaml;
    age.sshKeyPaths = [ "/etc/ssh/ssh_host_ed25519_key" ];

    secrets.wireguard-private-key = {
      mode = "0400";
      owner = "root";
    };
  };
}
